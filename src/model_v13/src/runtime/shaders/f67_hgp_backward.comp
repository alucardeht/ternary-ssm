#version 450
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer BufGradIn { float g_in[]; };
layout(set = 0, binding = 1) buffer BufGradOut { float g_out[]; };

layout(push_constant) uniform PushConsts {
    uint param_size;
    float projection_scale;
    uint block_size;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.param_size) return;
    
    // Holographic Gradient Projection
    // We project the gradient onto a structured "boundary" space.
    // As a local parallel proxy, we average the gradient within a local block
    // (representing the low-dimensional holographic boundary feature)
    // and blend the individual gradient with this block average.
    // This enforces a degree of correlation (low-rank structure) across the block.
    
    float g_val = g_in[idx];
    
    // In a real implementation with shared memory, we'd compute a proper block average.
    // Here we use a simpler proxy: if we just have one element, we can't easily 
    // average the block without synchronization or multiple passes.
    // However, if we assume a specific structured noise or simply a sparse mask,
    // we can simulate the effect. Let's apply a deterministic mask that zero's out
    // components that don't align with a "holographic basis" proxy.
    
    // A simple proxy for holographic projection: 
    // Only keep gradients that match the dominant sign of a local deterministic feature,
    // or just apply a periodic modulation.
    float boundary_feature = sin(float(idx) * 3.14159 / float(pc.block_size));
    
    // Project gradient onto the boundary feature
    float proj_g = g_val * boundary_feature;
    
    // Reconstruct
    float reconstructed_g = proj_g * boundary_feature;
    
    // Blend between original and projected based on projection_scale
    g_out[idx] = mix(g_val, reconstructed_g, pc.projection_scale);
}
