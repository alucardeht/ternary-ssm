#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer In { float in_data[]; };
layout(set = 0, binding = 1) writeonly buffer Out { float out_data[]; };
layout(push_constant) uniform PC { uint B; uint D; uint T; } pc;
void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.B * pc.D * pc.T) return;
    uint b = idx / (pc.D * pc.T);
    uint rem = idx % (pc.D * pc.T);
    uint d = rem / pc.T;
    uint t = rem % pc.T;
    out_data[b * (pc.T * pc.D) + t * pc.D + d] = in_data[idx];
}
