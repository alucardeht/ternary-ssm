#version 450
layout(local_size_x = 256) in;

layout(set = 0, binding = 0)          buffer BufParam { float param[]; };
layout(set = 0, binding = 1) readonly buffer BufGrad  { float grad[];  };
layout(set = 0, binding = 2)          buffer BufM     { float m_buf[]; };
layout(set = 0, binding = 3)          buffer BufV     { float v_buf[]; };

layout(push_constant) uniform PC {
    uint  N;
    float lr;
    float beta1;
    float beta2;
    float eps;
    float inv_bc1;
    float inv_bc2;
    float clamp_lo;
    float clamp_hi;
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= N) return;

    float g = grad[i];

    float m = beta1 * m_buf[i] + (1.0 - beta1) * g;
    float v = beta2 * v_buf[i] + (1.0 - beta2) * g * g;
    m_buf[i] = m;
    v_buf[i] = v;

    float m_hat = m * inv_bc1;
    float v_hat = v * inv_bc2;

    float p = param[i] - lr * m_hat / (sqrt(v_hat) + eps);

    if (clamp_lo > -1e30) p = max(p, clamp_lo);
    if (clamp_hi <  1e30) p = min(p, clamp_hi);

    param[i] = p;
}
