#version 450
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer BufW { float W[]; };
layout(set = 0, binding = 1) buffer BufM { float M[]; };
layout(set = 0, binding = 2) buffer BufV { float V[]; };
layout(set = 0, binding = 3) readonly buffer BufG { float G[]; };

layout(push_constant) uniform PC {
    uint ds;
    float lr;
    float beta1;
    float beta2;
    float eps;
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= ds) return;

    float g = G[i];
    float m = beta1 * M[i] + (1.0 - beta1) * g;
    float v = beta2 * V[i] + (1.0 - beta2) * g * g;

    M[i] = m;
    V[i] = v;

    W[i] -= lr * m / (sqrt(v) + eps);
}
