#version 450
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer BufGradIn { float g_in[]; };
layout(set = 0, binding = 1) buffer BufGradOut { float g_out[]; };
layout(set = 0, binding = 2) buffer BufBlockVariance { float block_var[]; };

layout(push_constant) uniform PushConsts {
    uint param_size;
    float variance_threshold; // threshold to determine "high variance" vs "low variance" block
    float high_var_multiplier;
    float low_var_multiplier;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.param_size) return;
    
    // Anisotropic Block Coordinate Descent (proxy)
    // We update parameters with step sizes modulated by their block's variance.
    // High-variance blocks get larger updates (or are updated, while others are skipped/dampened).
    
    float g_val = g_in[idx];
    float b_var = block_var[idx]; // block_var assumed mapped to param index
    
    float out_g = g_val;
    if (b_var > pc.variance_threshold) {
        out_g *= pc.high_var_multiplier;
    } else {
        out_g *= pc.low_var_multiplier;
    }
    
    g_out[idx] = out_g;
}
