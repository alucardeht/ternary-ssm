#version 450
layout(local_size_x = 256) in;

layout(push_constant) uniform PushConstants {
    uint total_elements;
    float delta;
} push;

layout(std430, binding = 0) buffer StateBuffer {
    float h[];
};

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= push.total_elements / 2) return;
    
    uint i = id * 2;
    float h0 = h[i];
    float h1 = h[i+1];
    
    float c = cos(push.delta);
    float s = sin(push.delta);
    
    h[i]   = h0 * c + h1 * s;
    h[i+1] = -h0 * s + h1 * c;
}
