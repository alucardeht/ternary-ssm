#version 450
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer BufH { float h_cache[]; };
layout(set = 0, binding = 1) buffer BufCov { float cov_ema[]; };

layout(push_constant) uniform PC {
    uint batch_size;
    uint seq_len;
    uint d_state;
    float beta;
} pc;

void main() {
    uint i = gl_LocalInvocationID.x;
    if (i >= pc.d_state) return;

    float var = 0.0;
    uint total = pc.batch_size * pc.seq_len;
    for (uint bt = 0; bt < total; bt++) {
        float h = h_cache[bt * pc.d_state + i];
        var += h * h;
    }
    var /= float(total);

    cov_ema[i] = pc.beta * cov_ema[i] + (1.0 - pc.beta) * var;
}
