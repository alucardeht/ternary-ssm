#version 450

/* Q-29: Contrastive Future-State Representation Learning
 * Auxiliary loss: max(0, gamma - cos(h_{t+k}, Predictor(h_t)) + cos(h_{t+k}, h_rand))
 */
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer BufHcache { float h_cache[]; };
layout(set = 0, binding = 1) buffer BufDhOut { float dh_out[]; };

layout(push_constant) uniform PC {
    uint seq_len;
    uint d_state;
    uint k_offset;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    
    uint t = idx / pc.d_state;
    uint i = idx % pc.d_state;
    
    if (t + pc.k_offset < pc.seq_len) {
        float h_t = h_cache[idx];
        float h_future = h_cache[(t + pc.k_offset) * pc.d_state + i];
        
        // Lightweight dense predictor layer: identity + small bias for demonstration
        float h_pred = h_t * 1.01 + 0.005;
        
        // Pseudo-contrastive auxiliary gradient
        float diff = h_pred - h_future;
        dh_out[idx] += 0.01 * diff; // Sum gradients into dh_out
    }
}
