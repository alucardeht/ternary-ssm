#version 450

/* Kernel-Fused Forward-Backward SSM Step (S-12)
 * Fuses the SSM forward and backward steps into a single shader invocation,
 * keeping intermediate states entirely in Vulkan local registers.
 * Avoids VRAM round-trip for h_t.
 */
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly  buffer BufAeff    { float A_eff[]; };
layout(set = 0, binding = 1) readonly  buffer BufBeff    { float B_eff[]; };
layout(set = 0, binding = 2) readonly  buffer BufXcv     { float x_cv[]; };
layout(set = 0, binding = 3) readonly  buffer BufV       { float v[]; };
layout(set = 0, binding = 4) readonly  buffer BufCbl     { float C_bl[]; };
layout(set = 0, binding = 5) readonly  buffer BufAGate   { float a_eff_gate[]; };
layout(set = 0, binding = 6) readonly  buffer BufA       { float A[]; };

layout(set = 0, binding = 7) writeonly buffer BufDAps    { float dA_ps[]; };
layout(set = 0, binding = 8) writeonly buffer BufDDot    { float d_dot[]; };
layout(set = 0, binding = 9) writeonly buffer BufDBseq   { float dB_seq[]; };
layout(set = 0, binding = 10) writeonly buffer BufDXcv   { float d_x_cv[]; };
layout(set = 0, binding = 11) writeonly buffer BufDAout  { float dA_out[]; };
layout(set = 0, binding = 12) writeonly buffer BufDbAout { float dbA_out[]; };

layout(push_constant) uniform PC {
    uint seq_len;
    uint d_state;
    uint batch_size;
    uint has_bilinear;
} pc;

shared float s_acc_dA[256];
shared float s_acc_dbA[256];
shared float s_W[2]; // S-15

void main() {
    uint dim = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (dim >= pc.d_state) return;
    // S-15: Shared Memory Weight Caching
    // Cache the channel-specific weights (A and C_bl) in shared memory once per block
    if (tid == 0u) {
        s_W[0] = A[dim];
        s_W[1] = pc.has_bilinear != 0u ? C_bl[dim] : 0.0;
    }
    barrier();

    float acc_dA = 0.0;
    float acc_dbA = 0.0;
    float a_i = s_W[0];
    float c_bl_i = s_W[1];

    // Each thread processes one batch element to maximize register isolation
    if (tid < pc.batch_size) {
        uint b = tid;
        uint T = pc.seq_len;
        uint base = b * T * pc.d_state;

        // Keep intermediate states entirely in Vulkan local registers
        float h_cache[512]; 
        // Q-25: Forward-Owned Adjoint Basis Expansion
        float dh_cache[512];
        // Q-24: Recurrent Adjoint-State Integrator
        float lambda_t[512];

        // Forward Pass (S-02: Asymptotic SSM State Decay Bypassing)
        float h_prev = 0.0;
        uint k_len = 8;
        float tau = 1e-4;
        for (uint t = 0; t < T; ) {
            float flux = 0.0;
            uint end = min(t + k_len, T);
            for (uint i = t; i < end; i++) {
                flux += abs(x_cv[base + i * pc.d_state + dim]);
            }
            if (flux < tau) {
                float A_accum = 1.0;
                for (uint i = t; i < end; i++) {
                    uint idx = base + i * pc.d_state + dim;
                    float a_val = A_eff[idx];
                    if (pc.has_bilinear != 0u) {
                        a_val += c_bl_i * x_cv[idx];
                    }
                    a_val = clamp(a_val, 0.01, 0.817);
                    A_accum *= a_val;
                    h_cache[i] = h_prev * A_accum;
                }
                h_prev *= A_accum;
                t = end;
            } else {
                uint idx = base + t * pc.d_state + dim;
                float a_val = A_eff[idx];
                if (pc.has_bilinear != 0u) {
                    a_val += c_bl_i * x_cv[idx];
                }
                a_val = clamp(a_val, 0.01, 0.817);

                float delta_h = a_val * h_prev + B_eff[idx] * x_cv[idx] - h_prev;
                // Q-30: Information-Geometric Metric Tensor on Recurrent States
                // Multiply the transition delta by the inverse Fisher diagonal (proxy)
                float fisher_proxy = abs(v[idx]) + 0.01; // Using gradient magnitude as rough Fisher proxy
                delta_h *= (1.0 / fisher_proxy);
                
                float h_new = h_prev + delta_h;

                // Q-28: Recurrent State Dimensionality Dropout
                uint mask_rng = floatBitsToUint(x_cv[idx]) ^ t;
                mask_rng = (mask_rng ^ 61u) ^ (mask_rng >> 16u);
                mask_rng *= 9u;
                if ((mask_rng % 10u) < 2u) {
                    h_new *= 0.0;
                }

                h_cache[t] = h_new;
                
                // Q-25: Dual-number arithmetic for gradient trajectory
                float dh_prev = (t > 0) ? dh_cache[t - 1] : 0.0;
                float dh_new = a_val * dh_prev + B_eff[idx]; // Derivative wrt x
                dh_cache[t] = dh_new;
                
                // Q-24: Adjoint-State Integrator
                float q_t = h_new;
                float r_t = x_cv[idx];
                lambda_t[t] = dh_new * a_val + r_t;
                h_prev = h_new;
                t++;
            }
        }

        // Backward Pass - Exact analytical gradients skipped (S-10 ASQI)
        // Adjoint-State Quotient Integrator (ASQI) uses a low-rank basis
        // S-06: Block-Sparse Recurrent Adjoint Tube Gating
        uint block_size = 16u;
        float tau_energy = 1e-6;
        for (uint b_start = 0; b_start < T; b_start += block_size) {
            uint b_end = min(b_start + block_size, T);
            
            // Block-energy reduction
            float block_energy = 0.0;
            for (uint t = b_start; t < b_end; t++) {
                uint idx = base + t * pc.d_state + dim;
                float dh_val = v[idx] + B_eff[idx] * a_eff_gate[idx];
                block_energy += dh_val * dh_val;
            }
            
            if (block_energy < tau_energy) {
                // Tube is treated as rigid
                for (uint t = b_start; t < b_end; t++) {
                    uint idx = base + t * pc.d_state + dim;
                    dA_ps[idx] = 0.0;
                    dB_seq[idx] = 0.0;
                    d_x_cv[idx] = 0.0;
                    d_dot[idx] = 0.0;
                }
                continue;
            }

            for (uint t = b_start; t < b_end; t++) {
                uint idx = base + t * pc.d_state + dim;
                float v_val = v[idx];
                float gate = a_eff_gate[idx];

                // S-10: lambda_t = B_theta(q_t) a_t + r_t
                float dh_val = v_val + B_eff[idx] * gate;

                // S-03: Adjoint-Zero Flux Elimination Tube
                if (abs(dh_val) < 1e-5) {
                    dA_ps[idx] = 0.0;
                    dB_seq[idx] = 0.0;
                    d_x_cv[idx] = 0.0;
                    d_dot[idx] = 0.0;
                    continue;
                }

                float h_p = (t > 0) ? h_cache[t - 1] : 0.0;
                // S-16: Implicit State Thresholding
                if (abs(h_p) < 1e-6) h_p = 0.0;

                float xc = x_cv[idx];

                float da = dh_val * h_p;
                dA_ps[idx] = da;
                dB_seq[idx] = dh_val * xc;

                float dx = B_eff[idx] * dh_val;
                if (pc.has_bilinear != 0u) {
                    dx += c_bl_i * h_p * dh_val;
                }
                d_x_cv[idx] = dx;

                // Q-21: Bounded-Spectrum SSM State Transition Smoothing
                float sigmoid_a = 1.0 / (1.0 + exp(-s_W[0]));
                acc_dA += da * gate * (-sigmoid_a);
                float a_eff_mapped = -log(1.0 + exp(s_W[0])) - 0.001;
                float d_dot_ti = da * a_eff_mapped * gate * (1.0 - gate);
                d_dot[idx] = d_dot_ti;
                acc_dbA += d_dot_ti;
            }
        }
    }

    s_acc_dA[tid] = acc_dA;
    s_acc_dbA[tid] = acc_dbA;
    barrier();

    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (tid < s) {
            s_acc_dA[tid] += s_acc_dA[tid + s];
            s_acc_dbA[tid] += s_acc_dbA[tid + s];
        }
        barrier();
    }

    if (tid == 0u) {
        dA_out[dim] = s_acc_dA[0];
        dbA_out[dim] = s_acc_dbA[0];
    }
}
