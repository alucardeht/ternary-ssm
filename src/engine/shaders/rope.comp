#version 450
#extension GL_EXT_scalar_block_layout : enable

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) readonly buffer WeightBuf {
    uint data[];
} weights;

layout(set = 0, binding = 1) buffer ScratchBuf {
    float data[];
} scratch;

layout(push_constant) uniform PushConstants {
    uint q_off;
    uint k_off;
    uint freq_off;
    int n_heads;
    int head_dim;
    int pos;
} pc;

void main() {
    uint head_idx = gl_GlobalInvocationID.x;

    if (head_idx >= uint(pc.n_heads)) {
        return;
    }

    uint q_base = pc.q_off / 4;
    uint k_base = pc.k_off / 4;
    uint freq_base = pc.freq_off / 4;

    uint head_start = head_idx * uint(pc.head_dim);

    for (int d = 0; d < pc.head_dim; d += 2) {
        if (d + 1 < pc.head_dim) {
            float inv_freq = uintBitsToFloat(weights.data[freq_base + d / 2]);
            float angle = inv_freq * float(pc.pos);

            float cos_val = cos(angle);
            float sin_val = sin(angle);

            float q0 = scratch.data[q_base + head_start + d];
            float q1 = scratch.data[q_base + head_start + d + 1];

            scratch.data[q_base + head_start + d] = q0 * cos_val - q1 * sin_val;
            scratch.data[q_base + head_start + d + 1] = q0 * sin_val + q1 * cos_val;

            float k0 = scratch.data[k_base + head_start + d];
            float k1 = scratch.data[k_base + head_start + d + 1];

            scratch.data[k_base + head_start + d] = k0 * cos_val - k1 * sin_val;
            scratch.data[k_base + head_start + d + 1] = k0 * sin_val + k1 * cos_val;
        }
    }
}
