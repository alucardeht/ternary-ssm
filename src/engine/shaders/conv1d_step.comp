#version 450
#extension GL_EXT_scalar_block_layout : enable

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer WeightBuf {
    uint data[];
} weights;

layout(set = 0, binding = 1) buffer ScratchBuf {
    float data[];
} scratch;

layout(push_constant) uniform PushConstants {
    uint y_off;
    uint conv_buf_off;
    uint x_off;
    uint w_off;
    uint bias_off;
    int d_inner;
    int d_conv;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= uint(pc.d_inner)) {
        return;
    }

    uint y_base = pc.y_off / 4;
    uint conv_buf_base = pc.conv_buf_off / 4;
    uint x_base = pc.x_off / 4;
    uint w_base = pc.w_off / 4;
    uint bias_base = (pc.bias_off != 0) ? (pc.bias_off / 4) : 0;

    float acc = 0.0;

    for (int k = 0; k < pc.d_conv; k++) {
        float state_val = scratch.data[conv_buf_base + idx * pc.d_conv + k];
        float weight = uintBitsToFloat(weights.data[w_base + idx * pc.d_conv + k]);
        acc += state_val * weight;
    }

    float new_input = scratch.data[x_base + idx];
    acc += new_input * uintBitsToFloat(weights.data[w_base + idx * pc.d_conv]);

    if (pc.bias_off != 0) {
        acc += uintBitsToFloat(weights.data[bias_base + idx]);
    }

    scratch.data[y_base + idx] = acc;

    for (int k = 1; k < pc.d_conv; k++) {
        scratch.data[conv_buf_base + idx * pc.d_conv + (k - 1)] =
            scratch.data[conv_buf_base + idx * pc.d_conv + k];
    }
    scratch.data[conv_buf_base + idx * pc.d_conv + (pc.d_conv - 1)] = new_input;
}
